---
/**
 * Home page — the single page for v1 (OVERVIEW.md §2.3).
 * Composes the six placeholder section components in order inside one <main>
 * landmark, rendered through Base.astro. Container styling consumes tokens
 * only; section internals are styled by each component's own scoped styles.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Personas from "../components/Personas.astro";
import Protocol from "../components/Protocol.astro";
import Install from "../components/Install.astro";
import Footer from "../components/Footer.astro";

const title = "metis — the meta-harness for AI coding agents";
const description =
  "metis governs AI coding agents with a disciplined protocol: one slice at a time, file scope as a contract, and cross-vendor review — so scope creep, self-review, and lost context stop happening.";
---

<Base title={title} description={description}>
  <main>
    <Hero />
    <Problem />
    <Personas />
    <Protocol />
    <Install />
    <Footer />
  </main>
</Base>

<style>
  main {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
</style>
